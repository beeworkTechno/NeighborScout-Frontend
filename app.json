{
  "expo": {
    "name": "NeighborScout",
    "slug": "neighborscout",
    "version": "1.0.0",
    "scheme": "neighborscout",
    "orientation": "portrait",
    "userInterfaceStyle": "light",

    "web": {
      "bundler": "metro"
    },

    "experiments": {
      "baseUrl": "/NeighborScout-Frontend"
    },

    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser"
    ],

    "android": {
      "package": "com.neighborscout.neighborscout",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "READ_MEDIA_IMAGES"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },

    "ios": {
      "bundleIdentifier": "com.neighborscout.neighborscout",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "NeighborScout uses your location to show nearby businesses.",
        "NSPhotoLibraryUsageDescription": "NeighborScout needs photo library access to upload business and profile photos.",
        "NSCameraUsageDescription": "NeighborScout may use the camera to add business and profile photos."
      }
    },

    "extra": {
      "router": {},
      "eas": {
        "projectId": "6c43d551-4c1f-4005-94e9-c1a99c98a739"
      }
    }
  }
}